       - _enabled="0": 默认禁用，需要特定条件激活
       - image_file="data/enemies_gfx/player_lukky.xml": 使用Lukki形态精灵文件
       - 其他参数与正常形态相同，保持视觉一致性 -->
  <SpriteComponent 

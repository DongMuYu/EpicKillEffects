  <!-- 参数说明：
       - aabb_min_x="-3", aabb_min_y="-12": 碰撞盒左下角边界
       - aabb_max_x="3", aabb_max_y="4": 碰撞盒右上角边界
       - is_enemy="0": 不是敌人
       - is_item="0": 不是物品
       - is_player="1": 是玩家实体 -->
  <HitboxComponent 

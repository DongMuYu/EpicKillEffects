  <!-- 粒子发射器组件1 - 玩家快速移动时的白色火花轨迹效果 -->
  <!-- 这个组件在玩家快速移动时产生白色火花粒子，增强视觉效果 -->
  <!-- 参数说明：
       - emitted_material_name="spark_white": 发射白色火花材质
       - offset.x/y: 粒子发射位置偏移
       - count_min/max: 每次发射1个粒子
       - lifetime_min/max: 粒子存在时间0.3-0.5秒
       - is_trail="1": 作为轨迹效果
       - airflow_force: 空气流动影响强度
       - emission_interval: 每帧发射一次
       - emit_cosmetic_particles: 只发射装饰性粒子 -->
  <ParticleEmitterComponent 
    _tags="fast_movement_particles"
    emitted_material_name="spark_white"
    offset.x="0"
    offset.y="3"
    x_pos_offset_min="0"
    x_pos_offset_max="0"
    y_pos_offset_min="0"
    y_pos_offset_max="0"
    x_vel_min="0"
    x_vel_max="0"
    y_vel_min="0"
    y_vel_max="0"
    gravity.y="0.0"
    count_min="1"
    count_max="1"
    lifetime_min="0.3"
    lifetime_max="0.5"
    is_trail="1"
    trail_gap="1.0"
    render_on_grid="1"
    fade_based_on_lifetime="1"
    airflow_force="0.1"
    airflow_time="0.001"
    airflow_scale="0.0833"
    emission_interval_min_frames="1"
    emission_interval_max_frames="1"
    emit_cosmetic_particles="1"
    create_real_particles="0"
    cosmetic_force_create="0"
    ignore_transform_updated_msg="1"
    is_emitting="1"
    >
  </ParticleEmitterComponent>


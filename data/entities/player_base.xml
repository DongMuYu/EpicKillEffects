<!-- 玩家基础实体配置文件 - 定义玩家的核心物理、视觉、音频和交互组件 -->
<!-- 这个文件包含了玩家角色的所有基本属性和行为组件 -->
<Entity 
  name="DEBUG_NAME:player"
  tags="mortal,human,hittable,peasant,prey,player_unit,teleportable" >
  
  <!-- 手部热点组件 - 定义玩家手持物品和武器的位置 -->
  <!-- 用于确定法杖、物品等相对于玩家精灵的附着点 -->
  <HotspotComponent
      _tags="hand"
      sprite_hotspot_name="hand"
  ></HotspotComponent>

  <!-- 射击位置热点组件 - 定义玩家发射投射物的位置 -->
  <!-- 这是玩家发射法杖法术、子弹等投射物的起点位置 -->
  <HotspotComponent
    _tags="shoot_pos"
    offset.x="0"
    offset.y="-2"
  ></HotspotComponent>

  <HotspotComponent
    _tags="kick_pos"
    offset.x="0"
    offset.y="2"
  ></HotspotComponent>
  
  <HotspotComponent
    _tags="crouch_sensor"
    offset.x="0"
    offset.y="-14"
  ></HotspotComponent>

  <!-- 物理拾取组件 - 控制玩家拾取和携带物理对象 -->
  <!-- 定义玩家手部关节位置和拾取强度 -->
  <!-- 参数说明：
       - original_left_joint_pos: 左手关节相对于玩家的位置
       - original_right_joint_pos: 右手关节相对于玩家的位置  
       - pick_up_strength="400": 拾取力度为400单位 -->
  <PhysicsPickUpComponent 
    original_left_joint_pos.x="-8"
    original_left_joint_pos.y="-2"
    original_right_joint_pos.x="-2"
    original_right_joint_pos.y="-2"
    pick_up_strength="400"
  ></PhysicsPickUpComponent>

  <!-- 平台射击玩家组件 - 控制玩家相机和进食行为 -->
  <!-- 这个组件处理玩家视角、瞄准和消耗物质的核心功能 -->
  <!-- 参数说明：
       - center_camera_on_this_entity="1": 相机始终对准玩家
       - aiming_reticle_distance_from_character="60": 准星距离玩家60像素
       - camera_max_distance_from_character="50": 相机最大跟随距离50像素  
       - move_camera_with_aim="1": 瞄准移动时相机跟随
       - eating_area: 定义玩家可以消耗物质的区域范围
       - eating_cells_per_frame="2": 每帧最多消耗2个物质单元 -->
  <PlatformShooterPlayerComponent
    center_camera_on_this_entity="1"
    aiming_reticle_distance_from_character="60"
    camera_max_distance_from_character="50"
    move_camera_with_aim="1"
    eating_area_min.x="-6"
    eating_area_max.x="6"
    eating_area_min.y="-4"
    eating_area_max.y="6"
    eating_cells_per_frame="2"
  ></PlatformShooterPlayerComponent>
  
  <PathFindingGridMarkerComponent
    player_marker_radius="100.0"
    marker_offset_y="-3"
    marker_work_flag="8"
  ></PathFindingGridMarkerComponent>

  <PlayerCollisionComponent 
    getting_crushed_threshold="6"
    moving_up_before_getting_crushed_threshold="6"
  ></PlayerCollisionComponent >

  <!-- 角色数据组件 - 定义角色的基本物理和移动属性 -->
  <!-- 这个组件控制角色的核心物理行为，包括碰撞检测、着陆效果、飞行机制等 -->
  <!-- 参数说明：
       - platforming_type="2": 平台类型为2（高级平台支持）
       - collision_aabb: 定义碰撞边界框（左右上下边界）
       - climb_over_y="4": 可以翻越4像素高的障碍物
       - eff_hg_*: 着陆效果参数（位置、大小、速度范围、伤害值）
       - fly_time_max="3.0": 最大飞行时间3秒
       - fly_recharge_spd: 飞行能量回复速度
       - flying_needs_recharge="1": 飞行需要充能
       - gravity="0": 重力影响（0为正常重力）
       - buoyancy_check_offset_y="-7": 浮力检测偏移 -->
  <CharacterDataComponent 
    platforming_type="2"
    check_collision_max_size_x="4" 
    check_collision_max_size_y="4" 
    climb_over_y="4" 
    collision_aabb_min_x="-2.0" 
    collision_aabb_max_x="2.0" 
    collision_aabb_min_y="-4.5" 
    collision_aabb_max_y="2.1"
    eff_hg_offset_y="1.28572" 
    eff_hg_position_x="0" 
    eff_hg_position_y="5" 
    eff_hg_size_x="6.42857" 
    eff_hg_size_y="5.14286" 
    eff_hg_velocity_max_x="19.5787896514" 
    eff_hg_velocity_max_y="-11.5714" 
    eff_hg_velocity_min_x="-19.5714" 
    eff_hg_velocity_min_y="-40" 
    eff_hg_damage_min="10"
    eff_hg_damage_max="95"
    eff_hg_update_box2d="0"
    eff_hg_b2force_multiplier="0.0015"
    effect_hit_ground="1" 
    fly_time_max="3.0"
    fly_recharge_spd="0.4"
    fly_recharge_spd_ground="6"
    flying_needs_recharge="1"
    flying_in_air_wait_frames="38"
    flying_recharge_removal_frames="8"
    gravity="0"
    buoyancy_check_offset_y="-7"
    send_transform_update_message="1"
  ></CharacterDataComponent>

  <!-- 基因组数据组件 - 定义玩家在生态系统中的属性 -->
  <!-- 这个组件确定玩家在游戏生态系统中的身份和行为 -->
  <!-- 参数说明：
       - herd_id="player": 玩家群体ID，将玩家归类为"玩家"群体
       - food_chain_rank="20": 食物链等级20（很高，顶级掠食者）
       - is_predator="1": 标记为掠食者
       - berserk_dont_attack_friends="1": 狂暴状态下不攻击友方单位 -->
  <GenomeDataComponent 
    herd_id="player"
    food_chain_rank="20"
    is_predator="1"
    berserk_dont_attack_friends="1"
  ></GenomeDataComponent>

  <!-- 角色平台组件 - 控制角色的移动、跳跃和飞行 -->
  <!-- 这个组件定义玩家的移动物理特性，包括跳跃、飞行、鼠标瞄准等 -->
  <!-- 参数说明：
       - jump_keydown_buffer="2": 跳跃按键缓冲帧数（2帧内按键都有效）
       - jump_velocity_y="-95": 向上跳跃速度95（负值表示向上）
       - jump_velocity_x="56": 水平跳跃速度56
       - fly_*: 飞行相关参数（最大上升/下降速度、飞行倍率等）
       - mouse_look="1": 启用鼠标瞄准
       - keyboard_look="1": 启用键盘瞄准
       - pixel_gravity="350": 重力加速度350
       - run_velocity="154": 跑步速度154
       - accel_x="0.15": 水平加速度0.15
       - velocity_min/max: 速度限制范围 -->
  <CharacterPlatformingComponent 
    animation_to_play="" 
    jump_keydown_buffer="2" 
    jump_velocity_y="-95" 
    jump_velocity_x="56"
    fly_model_player="0"
    fly_smooth_y="0"
    fly_speed_max_up="95"
    fly_speed_max_down="85"
    fly_speed_mult="20"
    fly_speed_change_spd="0.25"
    mouse_look="1" 
    keyboard_look="1"
    mouse_look_buffer="1" 
    pixel_gravity="350" 
    run_velocity="154"
    fly_velocity_x="52" 
    accel_x="0.15" 
    turning_buffer="0.5" 
    velocity_min_x="-57" 
    velocity_max_x="57" 
    velocity_min_y="-200"
    velocity_max_y="350"
  ></CharacterPlatformingComponent>

  <!-- 控制组件 - 处理玩家输入 -->
  <!-- 这个组件管理玩家的输入控制，包括手柄和键盘鼠标输入 -->
  <!-- 参数说明：
       - enabled="1": 启用控制组件
       - gamepad_fire_on_thumbstick_extend="0": 禁用手柄摇杆延伸射击
       - gamepad_fire_on_thumbstick_extend_threshold="0.9": 摇杆延伸90%才触发射击
       - gamepad_indirect_aiming_enabled="0": 禁用手柄间接瞄准辅助 -->
  <ControlsComponent 
    enabled="1" 
    gamepad_fire_on_thumbstick_extend="0"
    gamepad_fire_on_thumbstick_extend_threshold="0.9"
    gamepad_indirect_aiming_enabled="0"
  ></ControlsComponent>
  
  <!-- 伤害模型组件 - 定义玩家的生命值、伤害抗性和各种伤害源 -->
  <!-- 这个组件管理玩家的生存能力，包括HP、伤害计算、抗性等 -->
  <!-- 参数说明：
       - hp="4": 基础生命值4点
       - invincibility_frames="60": 受伤后无敌时间60帧（约1秒）
       - air_in_lungs="7": 肺部空气量7单位
       - falling_damages="0": 禁用坠落伤害
       - fire_damage_amount="0.2": 火焰伤害量0.2
       - materials_that_damage: 会伤害玩家的材料列表（酸、岩浆、冷血、毒等20种）
       - materials_how_much_damage: 对应材料的伤害值
       - damage_multipliers: 伤害倍率（爆炸伤害65%抗性，神圣伤害50%增伤） -->
  <DamageModelComponent 
    air_in_lungs="7" 
    air_in_lungs_max="7" 
    air_lack_of_damage="0.6" 
    air_needed="1" 
    falling_damage_damage_max="1.2" 
    falling_damage_damage_min="0.1" 
    falling_damage_height_max="250" 
    falling_damage_height_min="70" 
    falling_damages="0" 
    fire_damage_amount="0.2" 
    fire_probability_of_ignition="1" 
    invincibility_frames="60"
    hp="4" 
    is_on_fire="0" 
    materials_damage="1" 
    materials_that_damage="acid,lava,blood_cold_vapour,blood_cold,poison,radioactive_gas,radioactive_gas_static,rock_static_radioactive,rock_static_poison,ice_radioactive_static,ice_radioactive_glass,ice_acid_static,ice_acid_glass,rock_static_cursed,magic_gas_hp_regeneration,gold_radioactive,gold_static_radioactive,rock_static_cursed_green,cursed_liquid,poo_gas"  
    materials_how_much_damage="0.005,0.003,0.0006,0.0009,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.005,-0.005,0.0002,0.0002,0.004,0.0005,0.00001" 
    ragdoll_filenames_file="data/ragdolls/player/filenames.txt" 
    ragdoll_offset_y="-5"
    ragdollify_child_entity_sprites="1"
    blood_spray_material="blood"
    physics_objects_damage="0"
    critical_damage_resistance="1"
    ><damage_multipliers
      explosion="0.35" 
	  holy="1.5"
	  >
    </damage_multipliers>
  </DamageModelComponent>


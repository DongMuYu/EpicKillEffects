<Entity>
	<!-- 虚实体 - 支持自定义计时器参数 -->
	<!-- 可以通过VariableStorageComponent设置计时器持续时间 -->
	<!-- 使用完毕后自动删除 -->
	
	<!-- 计时器持续时间 -->
	<VariableStorageComponent
		name="timer_duration"
		value_int="0"
		>
	</VariableStorageComponent>
	
	<!-- 计时器标识符（用于区分多个计时器） -->
	<VariableStorageComponent
		name="timer_id"
		value_int = "0"
		>
	</VariableStorageComponent>
	
	<!-- 当前阶段 -->
	<VariableStorageComponent
		name="current_stage"
		value_int="1"
		value_string="false"
		>
	</VariableStorageComponent>
	
	<!-- 总阶段数 -->
	<VariableStorageComponent
		name="total_stages"
		value_int="3"
		>
	</VariableStorageComponent>
	
	<!-- 生命周期管理脚本 -->
	<LuaComponent
		script_source_file="data/scripts/timer_dummy.lua"
		execute_every_n_frame="1"
		remove_after_executed="0"
		>
	</LuaComponent>

